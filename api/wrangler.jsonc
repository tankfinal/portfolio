{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Workers Builds deploys this on every push to main that touches api/ (root directory /api/, watch path api/*).
  // Workers Builds deploys to whichever Worker the dashboard connected, even when `name` differs (seen on
  // 2026-10-13: the build connected to the old `blocks-leaderboard` deployed this code there). Renaming means
  // reconnecting the build in the dashboard too.
  "name": "tankos-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // The site calls the workers.dev URL; preview URLs are not needed.
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      "database_id": "9fa4e442-8026-4efc-b751-3035fbba223c"
    }
  ]
}
